{
  "name": "@polenta/desktop",
  "version": "0.0.8",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "electron-vite build && pnpm run build:mcp-server && electron-builder --publish never",
    "mcp-server": "tsx src/mcp-server/index.ts",
    "build:mcp-server": "esbuild src/mcp-server/index.ts --bundle --platform=node --format=cjs --outfile=out/mcp-server/index.cjs --external:keytar --external:react-native --external:react-native-fetch-blob --external:react-native-fs --alias:electron=./src/mcp-server/electron-shim.ts",
    "theme:generate": "tsx scripts/generate-theme-css.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polenta/api-client": "workspace:*",
    "@polenta/types": "workspace:*",
    "@polenta/zod-schemas": "workspace:*",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-router": "^1.36.0",
    "@tiptap/core": "^2.4.0",
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-link": "^2.4.0",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/extension-table": "^2.4.0",
    "@tiptap/extension-table-cell": "^2.4.0",
    "@tiptap/extension-table-header": "^2.4.0",
    "@tiptap/extension-table-row": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "alasql": "^4.17.3",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.0",
    "docx": "^9.7.1",
    "electron-updater": "^6.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.6",
    "isomorphic-git": "^1.25.0",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.390.0",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^17.0.10",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.3.0",
    "tiptap-markdown": "^0.8.10",
    "undici": "^6.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tanstack/router-vite-plugin": "^1.36.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.23.0",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
