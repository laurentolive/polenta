{
  "name": "@polenta/desktop",
  "version": "0.0.0-dev",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "electron-vite build && pnpm run build:mcp-server && pnpm run build:notices && tsx scripts/package.ts",
    "build:notices": "tsx scripts/generate-third-party-notices.ts",
    "mcp-server": "tsx src/mcp-server/dev-entry.ts",
    "build:mcp-server": "tsx scripts/build-mcp-server.ts",
    "dev:web": "concurrently -k -n server,client -c blue,magenta \"pnpm dev:web:server\" \"pnpm dev:web:client\"",
    "dev:web:server": "tsx watch --import ./scripts/register-brand.ts src/web-server/index.ts",
    "dev:web:client": "vite -c vite.web.config.ts",
    "build:web": "vite build -c vite.web.config.ts && pnpm run build:web-server && tsx scripts/generate-third-party-notices.ts out/web/THIRD-PARTY-NOTICES.txt",
    "build:web-server": "tsx scripts/build-web-server.ts",
    "demo:generate": "tsx ../../scripts/demo-lave-linge/generate.mjs",
    "start:web": "node out/web-server/index.cjs",
    "test": "vitest run",
    "test:e2e:web": "pnpm build:web && playwright test",
    "test:e2e:desktop": "electron-vite build && playwright test -c playwright.desktop.config.ts",
    "theme:generate": "tsx scripts/generate-theme-css.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-javascript": "6.2.2",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polenta/api-client": "workspace:*",
    "@polenta/merge-core": "workspace:*",
    "@polenta/types": "workspace:*",
    "@polenta/zod-schemas": "workspace:*",
    "@tanstack/react-query": "^5.40.0",
    "@tanstack/react-router": "^1.36.0",
    "@tiptap/core": "^2.4.0",
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-link": "^2.4.0",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/extension-table": "^2.4.0",
    "@tiptap/extension-table-cell": "^2.4.0",
    "@tiptap/extension-table-header": "^2.4.0",
    "@tiptap/extension-table-row": "^2.4.0",
    "@tiptap/pm": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "angular-expressions": "^1.7.0",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.0",
    "docx": "^9.7.1",
    "docxtemplater": "^3.71.0",
    "electron-updater": "^6.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.3.6",
    "isomorphic-git": "^1.25.0",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.390.0",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.0.0",
    "pizzip": "^3.3.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^17.0.10",
    "tailwind-merge": "^2.3.0",
    "tiptap-markdown": "^0.8.10",
    "undici": "^6.19.0",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3",
    "xlsx-template": "^1.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@playwright/test": "^1.64.0",
    "@tanstack/router-vite-plugin": "^1.36.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.23.0",
    "fastify": "^5.12.5",
    "playwright-core": "^1.64.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.0"
  }
