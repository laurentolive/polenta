# GH45 — configuration de l'hôte Polenta. À copier en /opt/polenta/host.env (chmod 600).

# E-mail de contact Let's Encrypt (avis d'expiration de certificat). Facultatif mais recommandé.
ACME_EMAIL=admin@example.fr

# Domaine parent des instances : <nom>.<BASE_DOMAIN>. DNS : *.BASE_DOMAIN → cet hôte (A + AAAA).
BASE_DOMAIN=forge.example.fr

# Versions épinglées (jamais « latest »). Défauts du kit si vides.
FORGE_IMAGE=codeberg.org/forgejo/forgejo
FORGE_VERSION=15.0.9
CADDY_VERSION=2.11.7

# SMTP (facultatif) — sans SMTP, les mots de passe temporaires sont affichés par polenta-admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Adresses de l'exploitant jamais bannies par fail2ban (IP fixes, séparées par des virgules).
# Laisser vide avec une IP dynamique ou partagée (mobile) : en cas de blocage, console KVM, cf. RUNBOOK.
ADMIN_IPS=

# Lien de téléchargement de Polenta cité dans les messages d'invitation (facultatif).
POLENTA_DOWNLOAD_URL=

# Sauvegardes (sprint 3) — stockage S3 chez un AUTRE fournisseur que l'hôte.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PING_URL=

# Cohabitation avec d'autres projets dockerisés sur un même serveur (GH61) — facultatif.
# Par défaut (CADDY_MODE=managed) le kit démarre son propre Caddy (ports 80/443) : rien à changer.
# CADDY_MODE=external : le kit ne crée aucun Caddy et ne touche pas à 80/443 (ufw : seul 22 ouvert).
# Votre Caddy existant doit être rattaché au réseau Docker EDGE_NETWORK (créé par vos soins :
# docker network create <nom>), lire CADDY_SITES_DIR en lecture seule et importer ses blocs :
#   import /opt/polenta/caddy-sites/*.caddy
# Valeurs par défaut ci-dessous (clés commentées = défaut appliqué) :
# CADDY_MODE=managed
# EDGE_NETWORK=polenta-edge
# CADDY_SITES_DIR=/opt/polenta/caddy-sites
# Commande shell (root) exécutée après chaque modification des blocs de site pour recharger votre
# Caddy, ex. docker exec caddy caddy reload --config /etc/caddy/Caddyfile — vide : rechargement manuel.
# CADDY_RELOAD_CMD=
