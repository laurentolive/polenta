# GH45 — configuration de l'hôte Polenta. À copier en /opt/polenta/host.env (chmod 600).

# E-mail de contact Let's Encrypt (avis d'expiration de certificat). Facultatif mais recommandé.
ACME_EMAIL=admin@example.fr

# Domaine parent des instances : <nom>.<BASE_DOMAIN>. DNS : *.BASE_DOMAIN → cet hôte (A + AAAA).
BASE_DOMAIN=forge.example.fr

# Versions épinglées (jamais « latest »). Défauts du kit si vides.
FORGE_IMAGE=codeberg.org/forgejo/forgejo
FORGE_VERSION=15.0.9
CADDY_VERSION=2.11.7

# SMTP (facultatif) — sans SMTP, les mots de passe temporaires sont affichés par polenta-admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Adresses de l'exploitant jamais bannies par fail2ban (IP fixes, séparées par des virgules).
# Laisser vide avec une IP dynamique ou partagée (mobile) : en cas de blocage, console KVM, cf. RUNBOOK.
ADMIN_IPS=

# Lien de téléchargement de Polenta cité dans les messages d'invitation (facultatif).
POLENTA_DOWNLOAD_URL=

# Sauvegardes (sprint 3) — stockage S3 chez un AUTRE fournisseur que l'hôte.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PING_URL=

# GH62 — durcissement de l'hôte par `polenta-host setup` (rejouable, n'annule jamais rien).
#   full  (défaut) pare-feu ufw, fail2ban, mises à jour auto avec redémarrage 04:00, SSH durci,
#                  LLMNR/mDNS coupés, console — VPS neuf dédié à Polenta
#   basic          fail2ban (sshd + forges) et mises à jour auto SANS redémarrage ; ni pare-feu ni SSH
#   none           Docker, restic, sauvegarde nocturne, Caddy seulement — serveur déjà administré
# Docker, restic et la sauvegarde nocturne sont actifs à tous les niveaux.
HARDEN_HOST=full
# Surcharge fine (facultatif) : liste de modules qui REMPLACE celle du niveau. Modules : firewall,
# fail2ban, fail2ban-forge (requiert fail2ban), unattended, unattended-reboot (requiert unattended),
# ssh-hardening, backup-cron, resolved, console. Exemple : HOST_MODULES=fail2ban,fail2ban-forge,backup-cron
#HOST_MODULES=
