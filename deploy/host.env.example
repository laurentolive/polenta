# GH45 — configuration de l'hôte Polenta. À copier en /opt/polenta/host.env (chmod 600).

# E-mail de contact Let's Encrypt (avis d'expiration de certificat). Facultatif mais recommandé.
ACME_EMAIL=admin@example.fr

# Domaine parent des instances : <nom>.<BASE_DOMAIN>. DNS : *.BASE_DOMAIN → cet hôte (A + AAAA).
BASE_DOMAIN=forge.example.fr

# Versions épinglées (jamais « latest »). Défauts du kit si vides.
FORGE_IMAGE=codeberg.org/forgejo/forgejo
FORGE_VERSION=15.0.9
CADDY_VERSION=2.11.7

# SMTP (facultatif) — sans SMTP, les mots de passe temporaires sont affichés par polenta-admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sauvegardes (sprint 3) — stockage S3 chez un AUTRE fournisseur que l'hôte.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_PING_URL=
